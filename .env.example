# Copy to .env.local and fill both values from Supabase Dashboard → Connect.
# NEXT_PUBLIC values are public; secret keys belong only in server variables below.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_REAL_VALUE
APP_URL=http://localhost:3000

# Server only, needed to settle signed VNPay IPN notifications. Never add NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# See docs/VNPAY-SANDBOX.md. Run supabase/enable-vnpay.sql on an existing database.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/payments/vnpay/return
