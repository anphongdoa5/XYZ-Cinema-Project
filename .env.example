# Copy to .env.local and fill both values from Supabase Dashboard → Connect.
# Project name is not the Project URL. Never put a secret/service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_REAL_VALUE
APP_URL=http://localhost:3000

# VNPay is intentionally not integrated yet. These values are not used.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/payments/vnpay/return
